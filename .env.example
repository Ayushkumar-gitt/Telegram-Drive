# PostgreSQL connection string from Neon (https://neon.tech) or any Postgres provider
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ── Admin Telegram account (for "simple" email+password users) ──────────────
# These are the credentials of YOUR (admin's) Telegram account.
# Simple users' files will be stored in this account.
# Get API_ID and API_HASH from https://my.telegram.org
ADMIN_API_ID=20976325
ADMIN_API_HASH=d6451bbb90f5e06cb86b46f4d6d4679a
# Generate a session string by logging in once with GramJS and saving the session:
ADMIN_SESSION_STRING=your_admin_session_string_here

# Optional: custom salt for password hashing (change this to something secret)
PASSWORD_SALT=starcloud-salt
